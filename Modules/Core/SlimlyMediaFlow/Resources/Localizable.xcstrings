    "picker.deniedNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Zugriff auf die Mediathek gibt es nichts auszuwählen. Erlaube den Zugriff in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without access to the library there is nothing to pick. Turn the permission on in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a la fototeca no hay nada que elegir. Activa el permiso en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès à la photothèque, il n’y a rien à choisir. Activez l’autorisation dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza accesso alla libreria non c’è nulla da scegliere. Attiva il permesso in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリにアクセスできないと選ぶものがありません。「設定」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 접근할 수 없으면 선택할 항목이 없습니다. 설정에서 권한을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso à fototeca não há o que escolher. Ative a permissão nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без доступа к медиатеке выбирать нечего. Разрешение включается в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有图库访问权限就无从选择。请在“设置”中开启权限。"
          }
        }
      }
    },
