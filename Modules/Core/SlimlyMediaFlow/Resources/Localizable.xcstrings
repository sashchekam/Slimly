    "preview.sourceNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original aus deiner Mediathek – so sieht es jetzt aus. Die Verarbeitung ändert es nicht: das Ergebnis wird eine eigene Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original from your library — this is how it looks now. Processing does not change it: the result becomes a separate file."
