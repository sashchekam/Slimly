    "failure.audioFromPhoto": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio lässt sich nur aus Videos extrahieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio can only be extracted from video"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio solo se puede extraer de vídeos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio ne peut être extrait que d’une vidéo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio si può estrarre solo dai video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はビデオからのみ抽出できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 동영상에서만 추출할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio só pode ser extraído de vídeos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук извлекается только из видео"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能从视频中提取音频"
          }
        }
      }
    },
