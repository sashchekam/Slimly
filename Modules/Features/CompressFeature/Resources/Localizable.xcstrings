    "level.estimate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minus %@ · geschätzt aus der Bitrate, die genaue Zahl kommt nach der Verarbeitung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minus %@ · estimated from bitrate, exact number after processing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos %@ · estimado por el bitrate; la cifra exacta, tras el procesamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins %@ · estimation d’après le débit, chiffre exact après traitement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno %@ · stima dal bitrate, il numero esatto dopo l’elaborazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイナス %@ · ビットレートからの概算です。正確な数値は処理後に分かります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 감소 · 비트레이트 기반 추정이며 정확한 값은 처리 후에 나옵니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos %@ · estimado pela taxa de bits, o número exato vem após o processamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минус %@ · оценка по битрейту, точная цифра — после обработки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少 %@ · 依据码率估算，确切数字在处理后给出"
          }
        }
      }
    },
