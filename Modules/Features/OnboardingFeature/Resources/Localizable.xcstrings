    "convert.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC – für den ganzen Stapel auf einmal, mit Aufnahmedatum und Ortsangabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC — for the whole batch at once, keeping the capture date and the location tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC: para todo el lote a la vez, conservando la fecha de captura y la geoetiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC — pour tout le lot d’un coup, en conservant la date de prise de vue et la géolocalisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC — per tutto il gruppo in una volta, mantenendo data di scatto e geotag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC、JPEG、PNG、H.264、HEVC — まとめて一括変換し、撮影日と位置情報も保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC — 한 번에 전체를 처리하며 촬영 날짜와 위치 정보를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC — para o lote inteiro de uma vez, mantendo a data de captura e a geolocalização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC, JPEG, PNG, H.264, HEVC — сразу для всей пачки, с сохранением даты съёмки и геометки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC、JPEG、PNG、H.264、HEVC — 一次处理整批，并保留拍摄日期和位置信息。"
          }
        }
      }
    },
