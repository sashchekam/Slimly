    "scan.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm die Seiten nacheinander auf: die Ränder werden selbst erkannt, das Bild wird begradigt, alles landet in einem PDF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoot the pages one after another: the bounds are found on their own, the frame is straightened, everything lands in a single PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía las páginas seguidas: los bordes se detectan solos, el encuadre se endereza y todo acaba en un único PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez les pages l’une après l’autre : les bords sont détectés tout seuls, l’image est redressée, tout arrive dans un seul PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta le pagine una dopo l’altra: i bordi si trovano da soli, l’inquadratura si raddrizza, tutto finisce in un unico PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを続けて撮るだけ。境界は自動で見つかり、傾きも補正され、すべてが 1 つの PDF になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 연달아 촬영하세요. 경계는 알아서 잡히고 기울기도 보정되어 하나의 PDF로 모입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe as páginas em sequência: as bordas são encontradas sozinhas, o quadro é endireitado e tudo vira um único PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
