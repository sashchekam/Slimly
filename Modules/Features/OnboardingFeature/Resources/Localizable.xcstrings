    "compress.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Fotos und Videos, stell die Stufe ein – wir zeigen die Größe vorher und nachher und einen Bildvergleich. Die Originale bleiben, bis du sie löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick photos and videos, set the level — we show the size before and after and a frame comparison. The originals stay until you delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige fotos y vídeos, ajusta el nivel: mostramos el tamaño antes y después y una comparación de fotogramas. Los originales se quedan hasta que tú los borres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez photos et vidéos, réglez le niveau — nous montrons la taille avant et après et une comparaison d’images. Les originaux restent jusqu’à ce que vous les supprimiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli foto e video, imposta il livello — mostriamo il peso prima e dopo e il confronto dei fotogrammi. Gli originali restano finché non li elimini tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオを選んでレベルを指定すると、前後のサイズと画質の比較を表示します。オリジナルは自分で削除するまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 고르고 수준을 정하면 전후 용량과 화면 비교를 보여줍니다. 원본은 직접 지우기 전까지 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha fotos e vídeos, defina o nível — mostramos o tamanho antes e depois e uma comparação de quadros. Os originais ficam até você apagá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фото и видео, задайте уровень — покажем размер до и после и сравнение кадров. Оригиналы остаются, пока вы сами не удалите их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片和视频、设定压缩程度，我们会展示处理前后的体积和画面对比。原件会一直保留，直到你自己删除。"
          }
        }
      }
    },
    "compress.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher freigeben, ohne etwas zu löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space without deleting anything"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio sin borrar nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l’espace sans rien supprimer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera spazio senza cancellare nulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除せずに空き容量を増やす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 지우지 않고 공간 확보"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere espaço sem apagar nada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите место, не удаляя ничего"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不删任何东西也能腾出空间"
          }
        }
      }
    },
