    "audio.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlesung, Interview, Sprachnachricht aus einem Video – wir sichern es als M4A oder WAV, ohne unnötig neu zu codieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lecture, an interview, a voice note inside a video — we save it as M4A or WAV without re-encoding anything extra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clase, una entrevista, una nota de voz dentro de un vídeo: lo guardamos como M4A o WAV sin recodificar de más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cours, une interview, un message vocal dans une vidéo — nous l’enregistrons en M4A ou WAV sans réencoder inutilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lezione, un’intervista, un messaggio vocale dentro un video — lo salviamo in M4A o WAV senza ricodifiche inutili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "講義、インタビュー、ビデオ内の音声メモ — 余計な再エンコードなしで M4A か WAV に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강의, 인터뷰, 동영상 속 음성 메모 — 불필요한 재인코딩 없이 M4A나 WAV로 저장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aula, uma entrevista, um áudio dentro de um vídeo — salvamos em M4A ou WAV sem recodificar à toa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лекция, интервью, голосовое из видео — сохраняем в M4A или WAV без перекодирования лишнего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讲座、访谈、视频里的语音 — 我们保存为 M4A 或 WAV，不做多余的重新编码。"
          }
        }
      }
    },
    "audio.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol den Ton aus dem Video"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the audio out of a video"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca el audio de un vídeo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrayez le son d’une vidéo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrai l’audio da un video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオから音声を取り出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상에서 소리만 꺼내기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire o áudio de um vídeo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаньте звук из видео"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把视频里的声音取出来"
          }
        }
      }
    },
