    "language.backToPhone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zur Sprache des Telefons"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to the phone’s language"
