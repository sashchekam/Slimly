      }
    },
    "language.footnoteManual": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Hand gewählt — die Sprache des Telefons ändert daran nichts mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chosen by hand — the phone’s language no longer changes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido a mano: el idioma del teléfono ya no lo cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisie à la main — la langue du téléphone n’y change plus rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelta a mano: la lingua del telefono non la cambia più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で選んだため、端末の言語を変えても切り替わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 선택했기 때문에 기기 언어를 바꿔도 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhido a mão — o idioma do telefone não muda mais isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбран вручную — язык телефона его больше не меняет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已手动选择，更改手机语言不会再影响它。"
          }
        }
      }
    },
    "language.footnoteSystem": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App folgt dem Telefon und nimmt die nächstgelegene Sprache, die sie hat. Gibt es keine, spricht sie Englisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app follows the phone and picks the closest language it has. If there is none, it speaks English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app sigue al teléfono y toma el idioma más cercano que tiene. Si no hay ninguno, habla en inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app suit le téléphone et prend la langue la plus proche dont elle dispose. À défaut, elle parle anglais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app segue il telefono e prende la lingua più vicina che ha. Se non ce n’è, parla inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは端末に合わせ、手持ちの中でいちばん近い言語を選びます。なければ英語になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 기기를 따라가며 보유한 언어 중 가장 가까운 것을 고릅니다. 없으면 영어로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app segue o telefone e usa o idioma mais próximo que tem. Se não houver nenhum, fala inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
