    "statistics.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheint die Aufschlüsselung nach Werkzeug – sobald du etwas komprimierst oder konvertierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
