            "value": "Tornare alla lingua del telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の言語に戻す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 언어로 되돌리기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar ao idioma do telefone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
