{
  "sourceLanguage": "en",
  "strings": {
    "format.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A ist unter iOS zu Hause, WAV ist verlustfrei, aber schwer. Das Video bleibt, wie es ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A is native to iOS, WAV is lossless but heavy. The video stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A es nativo de iOS; WAV no tiene pérdidas, pero pesa. El vídeo no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A est natif sur iOS, WAV est sans perte mais lourd. La vidéo reste telle quelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A è nativo su iOS, WAV è senza perdita ma pesante. Il video resta com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A は iOS 標準、WAV は可逆ですが重いです。ビデオはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A는 iOS 기본 형식이고 WAV는 무손실이지만 용량이 큽니다. 동영상은 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A é nativo do iOS; WAV é sem perdas, mas pesado. O vídeo fica como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A — родной для iOS, WAV без потерь, но тяжёлый. Видео не меняем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M4A 是 iOS 原生格式，WAV 无损但体积大。视频保持不变。"
          }
        }
      }
    },
