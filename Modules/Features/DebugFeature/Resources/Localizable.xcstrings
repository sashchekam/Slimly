          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON no válido: revisa las llaves, las comas y las comillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON non valide : vérifiez les accolades, les virgules et les guillemets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
