    "analytics.emptyNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat noch nichts gesendet. Nutze irgendein Werkzeug und komm zurück – der Eintrag erscheint sofort, auf die Web-Konsole muss man nicht warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has not sent anything yet. Run any tool and come back here — a record shows up right away, no need to wait for the web console."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app aún no ha enviado nada. Usa cualquier herramienta y vuelve aquí: el registro aparece al instante, sin esperar a la consola web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a encore rien envoyé. Utilisez n’importe quel outil et revenez ici — l’entrée apparaît aussitôt, inutile d’attendre la console web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non ha ancora inviato nulla. Usa un qualsiasi strumento e torna qui — la voce compare subito, non serve aspettare la console web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはまだ何も送信していません。どれかの機能を使ってここに戻ってください — レコードはすぐ現れ、Web コンソールを待つ必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 아직 아무것도 보내지 않았습니다. 아무 도구나 사용한 뒤 여기로 돌아오세요 — 레코드는 바로 나타나며 웹 콘솔을 기다릴 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app ainda não enviou nada. Use qualquer ferramenta e volte aqui — o registro aparece na hora, sem esperar o console web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение ещё ничего не отправило. Пройдите любой инструмент и вернитесь сюда — запись появляется сразу, ждать выгрузки в веб-консоль не нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 还没有发送任何内容。用任意工具走一遍再回到这里 — 记录会立刻出现，无需等待网页控制台。"
          }
        }
      }
    },
