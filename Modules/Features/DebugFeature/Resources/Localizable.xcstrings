    "analytics.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisse und Eigenschaften, die seit diesem Start an die Analytik gingen. Das Log liegt im Speicher: ein Neustart löscht es, bis dahin bleiben die letzten %lld Einträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events and properties sent to analytics since this launch. The log lives in memory: a restart wipes it, and until then it keeps the last %lld records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos y propiedades enviados a analíticas desde este arranque. El registro vive en memoria: un reinicio lo borra y hasta entonces guarda las últimas %lld entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événements et propriétés envoyés à l’analytique depuis ce lancement. Le journal vit en mémoire : un redémarrage l’efface, et jusque-là il garde les %lld dernières entrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventi e proprietà inviati all’analytics da questo avvio. Il log vive in memoria: un riavvio lo cancella, e fino ad allora conserva le ultime %lld voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この起動以降にアナリティクスへ送られたイベントとプロパティです。ログはメモリ上にあり、再起動で消えます。それまでは直近 %lld 件を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 실행 이후 애널리틱스로 보낸 이벤트와 속성입니다. 로그는 메모리에 있으며 재실행하면 지워지고, 그전까지 최근 %lld개를 보관합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos e propriedades enviados à análise desde esta abertura. O registro vive na memória: reiniciar apaga tudo e, até lá, guarda os últimos %lld itens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События и свойства, ушедшие в аналитику с этого запуска. Журнал живёт в памяти: перезапуск его обнуляет, а до этого хранятся последние %lld записей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次启动后发往分析的事件和属性。日志保存在内存中：重启即清空，在此之前保留最近 %lld 条记录。"
          }
        }
      }
    },
