          "stringUnit": {
            "state": "translated",
            "value": "La marca de que se mostró el tour: quítala y reinicia la app para empezar por el tour"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marque indiquant que la visite a été montrée — retirez-la et redémarrez l’app pour commencer par la visite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il segno che il tour è stato mostrato — toglilo e riavvia l’app per iniziare dal tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツアー表示済みの印です — 外してアプリを再起動するとツアーから始まります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투어를 보여줬다는 표시입니다 — 해제하고 앱을 다시 실행하면 투어부터 시작합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A marca de que o tour foi exibido — remova-a e reinicie o app para começar pelo tour"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка о показе тура — снимите её и перезапустите приложение, чтобы начать с тура"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记引导已展示 — 取消它并重启 App 就能从引导开始"
          }
        }
      }
    },
