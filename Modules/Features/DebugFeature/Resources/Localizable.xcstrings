    "knob.failureNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Datei scheitert mit dem gewählten Grund – so wird die Fehlerliste auf dem Ergebnisbildschirm sichtbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every file fails with the chosen reason — that is how the list of failures on the outcome screen becomes visible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada archivo falla con el motivo elegido: así se ve la lista de fallos en la pantalla de resultado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier échoue avec la raison choisie — c’est ainsi que la liste des échecs apparaît sur l’écran de résultat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni file fallisce con il motivo scelto — così si vede l’elenco degli errori nella schermata del risultato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ理由で各ファイルが失敗します — 結果画面の失敗一覧を確認できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 이유로 모든 파일이 실패합니다 — 결과 화면의 실패 목록을 볼 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada arquivo falha com o motivo escolhido — é assim que a lista de falhas aparece na tela de resultado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый файл отваливается с выбранной причиной — так видно список отказов на экране итога"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个文件都以所选原因失败 — 这样就能看到结果页的失败列表"
          }
        }
      }
    },
