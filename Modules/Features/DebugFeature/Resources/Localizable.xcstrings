    "knob.tierNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tier the tools take their limits from. There are no purchases yet: the flag is set by hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tarif, aus dem die Werkzeuge ihre Limits nehmen. Käufe gibt es noch nicht: Der Schalter wird von Hand gesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan del que las herramientas toman sus límites. Todavía no hay compras: el indicador se activa a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forfait dont les outils tirent leurs limites. Il n’y a pas encore d’achats : l’indicateur se règle à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano da cui gli strumenti prendono i loro limiti. Non ci sono ancora acquisti: l’indicatore si imposta a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ツールが上限を取る料金プラン。購入機能はまだないため、フラグは手動で切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 제한을 가져오는 요금제입니다. 아직 결제 기능이 없어 플래그는 직접 전환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano de onde as ferramentas tiram seus limites. Ainda não há compras: o sinalizador é definido à mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тариф, из которого инструменты берут пределы. Покупок ещё нет — флаг переставляют руками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各工具据以取用上限的套餐。目前还没有内购，此开关需手动切换。"
          }
        }
      }
    },
    "knob.tierSwitched": {
