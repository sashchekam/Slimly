          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON が不正です。かっこ、カンマ、引用符を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 JSON이 아닙니다. 괄호와 쉼표, 따옴표를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON inválido: verifique as chaves, as vírgulas e as aspas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не JSON: проверь скобки, запятые и кавычки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 无效：请检查括号、逗号和引号。"
          }
        }
      }
    },
    "config.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte vom Server und die lokalen Überschreibungen darüber. Eine Überschreibung lebt nur auf diesem Gerät und übersteht einen Neustart, die Bildschirme lesen den Wert beim Öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values from the server and the local overrides on top of them. An override lives only on this device and survives a restart, while screens read the value when they open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores del servidor y las sustituciones locales encima. Una sustitución vive solo en este dispositivo y sobrevive al reinicio; las pantallas leen el valor al abrirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs du serveur et surcharges locales par-dessus. Une surcharge ne vit que sur cet appareil et survit à un redémarrage, tandis que les écrans lisent la valeur à leur ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori dal server e le sostituzioni locali sopra di essi. Una sostituzione vive solo su questo dispositivo e sopravvive al riavvio, mentre le schermate leggono il valore all’apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの値と、その上に載るローカルの上書きです。上書きはこの端末にだけ残り再起動後も生き続け、画面は開いた時点の値を読みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 값과 그 위에 얹은 로컬 재정의입니다. 재정의는 이 기기에만 남고 재실행 후에도 유지되며, 화면은 열릴 때의 값을 읽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores do servidor e as substituições locais sobre eles. Uma substituição vive só neste dispositivo e sobrevive ao reinício, enquanto as telas leem o valor ao abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения с сервера и локальные подмены к ним. Подмена живёт только на этом устройстве и переживает перезапуск, а экраны читают значение в момент открытия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的值以及叠加其上的本地覆盖。覆盖只留在本机并在重启后依然有效，而界面在打开时读取当时的值。"
          }
        }
      }
    },
