    "menu.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Menü öffnet sich durch Schütteln des Geräts und existiert nur in internen Builds – im App Store gibt es das nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu opens by shaking the device and lives only in internal builds — it is not in the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El menú se abre agitando el dispositivo y solo existe en compilaciones internas: en el App Store no está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu s’ouvre en secouant l’appareil et n’existe que dans les builds internes — il n’est pas dans l’App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il menu si apre scuotendo il dispositivo ed esiste solo nelle build interne — nell’App Store non c’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューは端末を振ると開き、社内ビルドにのみ存在します — App Store 版にはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴는 기기를 흔들면 열리며 내부 빌드에만 있습니다 — App Store 버전에는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menu abre balançando o dispositivo e existe só em builds internas — na App Store não há."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню открывается тряской устройства и живёт только во внутренних сборках — в App Store его нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摇动设备即可打开该菜单，它只存在于内部构建中 — App Store 版本没有。"
          }
        }
      }
    },
