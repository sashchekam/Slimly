    "config.editNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert wird nur auf diesem Gerät überschrieben. Ein leeres Feld entfernt die Überschreibung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value is overridden only on this device. An empty field clears the override."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor se sustituye solo en este dispositivo. Un campo vacío retira la sustitución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur n’est surchargée que sur cet appareil. Un champ vide retire la surcharge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore viene sostituito solo su questo dispositivo. Un campo vuoto rimuove la sostituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はこの端末でのみ上書きされます。空欄にすると上書きが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 이 기기에서만 재정의됩니다. 빈 칸으로 두면 재정의가 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor é substituído só neste dispositivo. Um campo vazio remove a substituição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение подменится только на этом устройстве. Пустое поле снимает подмену."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该值只在本机被覆盖。留空即可取消覆盖。"
          }
        }
      }
    },
    "config.empty": {
