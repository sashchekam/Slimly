    "config.emptyNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration ist noch nicht geladen, im Projekt fehlt GoogleService-Info.plist, oder in der Web-Konsole wurde kein Parameter veröffentlicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config has not loaded yet, the project has no GoogleService-Info.plist, or no parameter has been published in the web console."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración aún no se ha cargado, el proyecto no tiene GoogleService-Info.plist o no se ha publicado ningún parámetro en la consola web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration n’est pas encore chargée, le projet n’a pas de GoogleService-Info.plist, ou aucun paramètre n’a été publié dans la console web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione non è ancora stata caricata, il progetto non ha GoogleService-Info.plist, oppure nella console web non è stato pubblicato alcun parametro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定がまだ読み込まれていないか、プロジェクトに GoogleService-Info.plist がないか、Web コンソールでパラメータが 1 つも公開されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 아직 로드되지 않았거나, 프로젝트에 GoogleService-Info.plist가 없거나, 웹 콘솔에 게시된 매개변수가 하나도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração ainda não carregou, o projeto não tem GoogleService-Info.plist ou nenhum parâmetro foi publicado no console web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиг ещё не загрузился, в проекте нет GoogleService-Info.plist или в веб-консоли не опубликовано ни одного параметра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置尚未加载，项目中没有 GoogleService-Info.plist，或者网页控制台还没有发布任何参数。"
          }
