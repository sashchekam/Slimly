    "paywall.legal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch, bis du es in den Apple-ID-Einstellungen kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription renews automatically until you cancel it in your Apple ID settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente hasta que la canceles en los ajustes de tu Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement se renouvelle automatiquement jusqu’à sa résiliation dans les réglages de l’identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento si rinnova automaticamente finché non lo disdici nelle impostazioni dell’ID Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、Apple ID の設定で解約するまで自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 Apple ID 설정에서 해지하기 전까지 자동으로 갱신됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente até ser cancelada nos ajustes do seu Apple ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка продлевается автоматически, пока её не отменить в настройках Apple ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将自动续期，直至你在 Apple ID 设置中取消。"
          }
        }
      }
    },
