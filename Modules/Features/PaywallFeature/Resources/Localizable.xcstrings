    "paywall.activeNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In allen Werkzeugen gibt es keine Limits mehr. Danke, dass du die App unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits are off in every tool. Thanks for supporting the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites han desaparecido en todas las herramientas. Gracias por apoyar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites ont disparu dans tous les outils. Merci de soutenir l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti sono spariti in tutti gli strumenti. Grazie per sostenere l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのツールで制限がなくなりました。アプリを支えてくれてありがとうございます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 도구에서 제한이 사라졌습니다. 앱을 응원해 주셔서 고맙습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites acabaram em todas as ferramentas. Obrigado por apoiar o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пределы сняты во всех инструментах. Спасибо, что поддерживаете приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有工具的限制都已解除。感谢你的支持。"
          }
        }
      }
    },
