    "photoFormat.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC ist leichter, JPEG läuft überall. PNG ist verlustfrei, aber schwerer als das Original. Das Ausgangsformat wird nicht aufgelistet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC is lighter, JPEG works everywhere. PNG is lossless but heavier than the original. The source format is not listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC pesa menos, JPEG es compatible con todo. PNG no tiene pérdidas, pero pesa más que el original. El formato de origen no aparece en la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC est plus léger, JPEG fonctionne partout. PNG est sans perte mais plus lourd que l’original. Le format source n’est pas listé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC pesa meno, JPEG va ovunque. PNG è senza perdita ma più pesante dell’originale. Il formato di origine non è in elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC は軽く、JPEG はどこでも使えます。PNG は可逆ですがオリジナルより重くなります。元の形式は一覧に出しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC는 더 가볍고 JPEG는 어디서나 열립니다. PNG는 무손실이지만 원본보다 무겁습니다. 원본 형식은 목록에 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC pesa menos, JPEG funciona em tudo. PNG é sem perdas, mas mais pesado que o original. O formato de origem não aparece na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC весит меньше, JPEG совместим со всем. PNG — без потерь, но тяжелее оригинала. Исходный формат в списке не показываем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC 更小，JPEG 兼容性最好。PNG 无损但比原件更大。列表中不显示原格式。"
          }
        }
      }
    },
