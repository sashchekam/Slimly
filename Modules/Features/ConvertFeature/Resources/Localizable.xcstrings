    "videoFormat.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist Neucodierung, keine umbenannte Endung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is re-encoding, not a renamed extension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recodificación, no un cambio de extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un réencodage, pas un changement d’extension."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una ricodifica, non un cambio di estensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張子の変更ではなく再エンコードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장자 변경이 아니라 재인코딩입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É recodificação, não troca de extensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это перекодирование, а не смена расширения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是重新编码，而非改扩展名。"
          }
        }
      }
    },
