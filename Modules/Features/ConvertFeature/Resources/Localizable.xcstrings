    "videoFormat.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC ergibt eine kleinere Datei, H.264 öffnet sich überall. Das ist Neucodierung, keine umbenannte Endung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC gives a smaller size, H.264 opens everywhere. This is re-encoding, not a renamed extension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC ocupa menos, H.264 se abre en todas partes. Es recodificación, no un cambio de extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC donne un fichier plus petit, H.264 s’ouvre partout. C’est un réencodage, pas un changement d’extension."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC pesa meno, H.264 si apre ovunque. È una ricodifica, non un cambio di estensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC はサイズが小さく、H.264 はどこでも開けます。拡張子の変更ではなく再エンコードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC는 용량이 작고 H.264는 어디서나 열립니다. 확장자 변경이 아니라 재인코딩입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC gera arquivos menores, H.264 abre em qualquer lugar. É recodificação, não troca de extensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC даёт меньший вес, H.264 открывается везде. Перекодирование, не смена расширения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC 体积更小，H.264 处处可开。这是重新编码，而非改扩展名。"
          }
        }
      }
    },
