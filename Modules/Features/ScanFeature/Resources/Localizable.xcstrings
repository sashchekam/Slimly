    "intro.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir finden die Ränder, begradigen die Seite und erstellen ein PDF – der Rahmen lässt sich von Hand anpassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
