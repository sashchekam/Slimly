        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ränder werden live erkannt, anpassen geht danach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounds are caught on the fly, adjust them afterwards"
          }
        },
        "es": {
