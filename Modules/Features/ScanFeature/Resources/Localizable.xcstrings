    "format.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild wird entlang der gewählten Ränder begradigt und der Hintergrund auf Weiß gezogen. S/W liefert den schärfsten Text, Farbe braucht es für Stempel und Bilder. Das Dokument lässt sich in Dateien sichern – die Originale bleiben in der Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frame is straightened along the chosen bounds and the background is pushed to white. B/w gives the crispest text, color is for stamps and pictures. The document can be saved to Files — the originals stay in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El encuadre se endereza según los bordes elegidos y el fondo se lleva a blanco. El b/n da el texto más nítido; el color hace falta para sellos e imágenes. El documento se podrá guardar en Archivos: los originales se quedan en la fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image est redressée selon les bords choisis et le fond est ramené au blanc. Le N/B donne le texte le plus net, la couleur sert aux tampons et aux images. Le document pourra être enregistré dans Fichiers — les originaux restent dans la photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inquadratura viene raddrizzata sui bordi scelti e lo sfondo portato al bianco. Il b/n dà il testo più nitido, il colore serve a timbri e immagini. Il documento potrà essere salvato in File — gli originali restano nella libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ境界に沿って傾きを補正し、背景を白に整えます。白黒が最も鮮明で、色は印影や図版に必要です。書類は「ファイル」に保存でき、オリジナルはライブラリに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 경계에 맞춰 화면을 바로잡고 배경을 흰색으로 정리합니다. 흑백이 글자가 가장 또렷하고, 색은 도장과 그림에 필요합니다. 문서는 파일에 저장할 수 있으며 원본은 보관함에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O enquadramento é endireitado pelas bordas escolhidas e o fundo vai para o branco. O p/b dá o texto mais nítido; a cor serve para carimbos e imagens. O documento poderá ser salvo em Arquivos — os originais ficam na fototeca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадр выпрямляем по выбранным границам, фон добиваем до белого. Ч/б даёт самый чёткий текст, цвет нужен печатям и картинкам. Документ можно будет сохранить в «Файлы» — оригиналы останутся в медиатеке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按所选边界校正画面，并将背景提亮为白色。黑白的文字最清晰，彩色适合印章和图片。文稿可保存到“文件”，原件仍留在图库中。"
          }
        }
      }
    },
