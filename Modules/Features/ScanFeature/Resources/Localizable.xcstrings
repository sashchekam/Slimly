    "camera.aimHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf eine Seite"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at a page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara a una página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez l’appareil vers une page"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta la fotocamera su una pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページにカメラを向けてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지에 카메라를 맞추세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera para uma página"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на страницу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将相机对准页面"
          }
        }
      }
    },
