    "camera.deniedNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die Kamera in den Einstellungen – Seiten kannst du aufnehmen oder aus der Mediathek wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the camera in Settings — pages can be shot or picked from your library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la cámara en Ajustes: las páginas se pueden fotografiar o elegir de la fototeca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’appareil photo dans Réglages — les pages peuvent être prises ou choisies dans la photothèque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la fotocamera in Impostazioni — le pagine si possono scattare o scegliere dalla libreria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でカメラを許可してください — ページは撮影するかライブラリから選べます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 카메라를 허용하세요 — 페이지는 촬영하거나 보관함에서 고를 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a câmera nos Ajustes — as páginas podem ser fotografadas ou escolhidas na fototeca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите съёмку в настройках — страницы можно снять или выбрать из галереи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许相机 — 页面可以拍摄，也可以从图库中选择"
          }
        }
      }
    },
