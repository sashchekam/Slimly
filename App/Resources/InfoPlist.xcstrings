    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly nutzt die Kamera, um Dokumentseiten aufzunehmen und zu einem PDF zusammenzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly uses the camera to shoot document pages and assemble them into a PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly usa la cámara para fotografiar páginas de documentos y componerlas en un PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly utilise l’appareil photo pour prendre les pages d’un document et les assembler en PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly usa la fotocamera per scattare le pagine di un documento e comporle in un PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly は書類のページを撮影して PDF にまとめるためにカメラを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly는 문서 페이지를 촬영해 PDF로 만들기 위해 카메라를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Slimly usa a câmera para fotografar páginas de documentos e montá-las em um PDF."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly включает камеру, чтобы снять страницы документа и собрать их в PDF."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly 使用相机拍摄文稿页面并将其合并为 PDF。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly sichert verarbeitete Dateien in deiner Fotomediathek – die Originale bleiben, wo sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly saves processed files to your photo library — the originals stay where they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly guarda los archivos procesados en tu fototeca; los originales se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly enregistre les fichiers traités dans votre photothèque — les originaux restent en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly salva i file elaborati nella tua libreria foto — gli originali restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly は処理したファイルを写真ライブラリに保存します。オリジナルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly는 처리한 파일을 사진 보관함에 저장하며, 원본은 그대로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Slimly salva os arquivos processados na sua fototeca — os originais ficam onde estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly сохраняет обработанные файлы в медиатеку — оригиналы остаются на месте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly 会把处理后的文件保存到照片图库 — 原件保持不变。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly zeigt deine Fotomediathek, damit du Dateien zum Komprimieren und Konvertieren auswählen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly shows your photo library so you can pick files to compress and convert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly muestra tu fototeca para que elijas archivos que comprimir y convertir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly affiche votre photothèque pour que vous choisissiez les fichiers à compresser et convertir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly mostra la tua libreria foto per farti scegliere i file da comprimere e convertire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮・変換するファイルを選べるように、Slimly が写真ライブラリを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축하고 변환할 파일을 고를 수 있도록 Slimly가 사진 보관함을 보여줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Slimly mostra sua fototeca para você escolher arquivos a comprimir e converter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly показывает медиатеку, чтобы вы выбрали файлы для сжатия и конвертации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimly 会显示你的照片图库，方便你选择要压缩和转换的文件。"
          }
        }
      }
